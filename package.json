{
  "name": "pi-web-fetch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local pi extension that converts public web pages to Markdown via markdown.new",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "ipaddr.js": "2.3.0",
    "jsdom": "27.4.0",
    "turndown": "7.2.2",
    "turndown-plugin-gfm": "1.0.2",
    "undici": "7.24.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@types/jsdom": "21.1.7",
    "@types/node": "22.19.19",
    "@types/turndown": "5.0.5",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
